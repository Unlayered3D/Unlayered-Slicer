#!/usr/bin/env bash
APPIMAGETOOLURL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage"
REPO_ROOT="@CMAKE_SOURCE_DIR@"

# APP_KEY is the display name and may contain a space ("Unlayered Slicer"), so every
# use of it has to be quoted; APP_CMD never contains one, which is why it -- not the
# key -- names the files inside the AppDir. The icon and metainfo assets are named
# after the one-word app id.
APP_KEY="@SLIC3R_APP_KEY@"
APP_CMD="@SLIC3R_APP_CMD@"
APP_IMAGE="${APP_KEY// /_}_Linux_V@UNLAYERED_VERSION@.AppImage"

ICON_SRC="${REPO_ROOT}/resources/images/UnlayeredSlicer_192px.png"
METAINFO_SRC="${REPO_ROOT}/scripts/flatpak/com.unlayered3d.UnlayeredSlicer.metainfo.xml"

# AppStream refuses to validate unless the metainfo filename and the desktop file it
# declares as launchable both match the <id> inside the metainfo, so take the id from
# the file being shipped instead of assuming it follows the app name.
APP_ID="$(sed -n 's:.*<id>\(.*\)</id>.*:\1:p' "${METAINFO_SRC}" | head -n1)"
[ -n "${APP_ID}" ] || APP_ID="com.unlayered3d.UnlayeredSlicer"

wget ${APPIMAGETOOLURL} -O ../appimagetool.AppImage
chmod +x ../appimagetool.AppImage

if [ -f /.dockerenv ] ; then # Only run if inside of a Docker Container
sed '0,/AI\x02/{s|AI\x02|\x00\x00\x00|}' -i  ../appimagetool.AppImage
fi

mv "${APP_CMD}" AppRun
chmod +x AppRun

cp "${ICON_SRC}" "${APP_CMD}.png"
mkdir -p usr/share/icons/hicolor/192x192/apps
cp "${ICON_SRC}" "usr/share/icons/hicolor/192x192/apps/${APP_CMD}.png"
cat <<EOF > "${APP_ID}.desktop"
[Desktop Entry]
Name=${APP_KEY}
Exec=AppRun %F
Icon=${APP_CMD}
Type=Application
Categories=Utility;
MimeType=model/stl;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;
EOF

mkdir -p usr/share/applications
cp "${APP_ID}.desktop" usr/share/applications/

mkdir -p usr/share/metainfo
cp "${METAINFO_SRC}" "usr/share/metainfo/${APP_ID}.metainfo.xml"
cp "${METAINFO_SRC}" "usr/share/metainfo/${APP_ID}.appdata.xml"

export ARCH=$(uname -m)

# Name the output explicitly. Left to itself appimagetool derives the filename from
# the desktop Name field, mangling the space in APP_KEY into an underscore, and the
# caller (build_linux_image.sh) then cannot find the file it expects to move.
if [ -f /.dockerenv ] ; then # Only run if inside of a Docker Container
  ../appimagetool.AppImage --appimage-extract-and-run $([ -n "${container:-}" ] && echo '--appimage-extract-and-run') . "${APP_IMAGE}"
else
  ../appimagetool.AppImage $([ -n "${container:-}" ] && echo '--appimage-extract-and-run') . "${APP_IMAGE}"
fi

chmod +x "${APP_IMAGE}"
